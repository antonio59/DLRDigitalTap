# Example environment variables for Convex connection
# Copy this file to `.env.local` and replace with your actual credentials.

# Convex (auto-generated when you run `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Resend
RESEND_API_KEY=your_resend_key
CONTACT_TO_EMAIL=you@example.com

# Admin dashboard (server-only — never prefix with NEXT_PUBLIC)
ADMIN_PASSWORD=your_secure_admin_password
# Dedicated high-entropy key for admin session tokens (optional but
# recommended — prevents a captured cookie from being an offline password oracle)
SESSION_SECRET=your_random_session_secret
# Shared secret between the /api/voter-token Pages Function and the Convex
# tokens:issue mutation. Must also be set on the Convex deployment.
TOKEN_ISSUER_SECRET=your_random_token_issuer_secret
# SHA-256 of the upstream Umami script, so /script.js only serves pinned bytes:
#   curl -s https://umami.antoniosmith.xyz/script.js | shasum -a 256
UMAMI_SCRIPT_SHA256=your_script_sha256_hex

# Convex deployment env vars (set via `npx convex env set`, not this file):
#   TOKEN_ISSUER_SECRET — must match the Pages secret above
#   ADMIN_PASSWORD — enables admin-gated mutations (comments:remove, lifecycle:eraseUser)
